DATABASE_URL=
FLOK_TOKEN_SECRET=
VITE_PUBLIC_HOSTNAME=
# Product default: spectators need no account. Set to true only if you need /login.
VITE_AUTH_ENABLED=false
# Dev-only. Never set in production. Required for POST /api/v1/seed.
FLOK_ALLOW_SEED=
# Sandbox only. Enables Grok PWA head rewrite (strips share metas, injects extensions.js).
# Leave unset for normal Flok local/prod so per-crew og:image survives.
FLOK_GROK_PLATFORM=
# Optional federated auth (never commit secrets). Prefer GROK_AUTH_* when deployed.
# GROK_AUTH_CLIENT_SECRET=
# GROK_PREVIEW_CLIENT_SECRET=
