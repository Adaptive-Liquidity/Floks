DATABASE_URL=
FLOK_TOKEN_SECRET=
# Stable HMAC key for non-enumerable public Contract poster ids.
# Required in production and whenever DATABASE_URL is configured.
FLOK_POSTER_SECRET=
VITE_PUBLIC_HOSTNAME=
# Product default: spectators need no account. Set to true only if you need /login.
VITE_AUTH_ENABLED=false
# Dev-only. Never set in production. Required for POST /api/v1/seed.
FLOK_ALLOW_SEED=
# Sandbox only. Enables Grok PWA head rewrite (strips share metas, injects extensions.js).
# Leave unset for normal Flok local/prod so per-crew og:image survives.
FLOK_GROK_PLATFORM=
# Optional read-only SPX402 evidence API. Unset means Grade safely falls back to SPX404.
FLOK_SPX402_URL=
# JSON map of "handle/cluster-slug" to a verified public SPX402 subject id.
FLOK_SPX402_SUBJECTS={}
# Exact upstream methodology version approved for Outcome Contract scoring.
FLOK_SPX402_OC_METHODOLOGY=
# S2-G2a Phase B: dedicated SPX staging egress. All three values are required;
# leave mode unset to keep egress closed. No production endpoint variable exists.
FLOK_SPX402_EGRESS_MODE=
FLOK_SPX402_STAGING_URL=
# Must equal OC_INGEST_SECRET on the dedicated SPX staging deployment.
OC_INGEST_SECRET=
# Bearer secret protecting POST /api/internal/oc-evidence/drain.
FLOK_OC_DRAIN_SECRET=
# Optional bounded drainer tuning (defaults: 25 rows, 5 attempts).
FLOK_OC_DRAIN_BATCH_SIZE=
FLOK_OC_DRAIN_MAX_ATTEMPTS=
# Optional federated auth (never commit secrets). Preview OAuth requires VITE_AUTH_ENABLED=true
# and either GROK_AUTH_CLIENT_SECRET or GROK_PREVIEW_CLIENT_SECRET.
# GROK_AUTH_CLIENT_SECRET=
# GROK_PREVIEW_CLIENT_SECRET=
