    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build:ci"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
